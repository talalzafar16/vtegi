DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

PAYLOAD_SECRET=

# Email (Resend). Leave empty in development: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=website@vtegi.com

# Cloudflare Turnstile spam protection. Leave empty in development to skip the check.
# REQUIRED in production. Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File storage for uploads (Supabase Storage, S3 protocol). Leave empty to use the local /media folder.
# Supabase → Project Settings → Storage → S3 Connection. Endpoint looks like:
# https://<project-ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set to true on preview/test deployments to keep them out of search engines.
NOINDEX=
