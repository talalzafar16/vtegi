{
  "name": "vtegi",
  "version": "1.0.0",
  "description": "VTEGI website and CMS (Next.js + Payload)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "media:upload": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/upload-media.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "1.6.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "^2.1.1",
    "cobe": "2.0.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "payload": "3.90.2",
    "radix-ui": "1.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.29",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
